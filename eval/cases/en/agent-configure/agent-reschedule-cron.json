{
  "id": "agent-reschedule-cron",
  "lang": "en",
  "category": "agent",
  "workflow": "agent-configure",
  "scenario_type": "single_turn",
  "description": "Migrate an interval agent to a cron schedule via `neomind agent update`.",
  "setup": {
    "fixture": "seed-default",
    "extras": {
      "agents": [
        {
          "name": "night-patrol",
          "user_prompt": "Patrol all devices",
          "schedule": {
            "schedule_type": "interval",
            "interval_seconds": 300
          }
        }
      ]
    }
  },
  "turns": [
    {
      "user": "Stop running night-patrol every 5 minutes — move it to a daily 06:00 UTC schedule instead."
    }
  ],
  "applies": [
    "tool_accuracy",
    "task_completion",
    "language_adherence"
  ],
  "expectations": {
    "per_turn": [
      "T1: `neomind agent update` to schedule-type cron with expression 0 6 * * * and timezone UTC"
    ],
    "overall": "night-patrol stored with cron 0 6 * * * / UTC"
  },
  "expect": {
    "tools": [
      "shell"
    ],
    "commands": [
      "neomind agent update"
    ],
    "substrings": {
      "neomind agent update": [
        "--schedule-type",
        "cron",
        "--schedule-config"
      ]
    }
  },
  "state_queries": [
    {
      "type": "agent_config",
      "params": {
        "name": "night-patrol",
        "field": "schedule_type"
      },
      "expected": "cron"
    },
    {
      "type": "agent_config",
      "params": {
        "name": "night-patrol",
        "field": "cron_expression"
      },
      "expected": "0 6 * * *"
    }
  ]
}
