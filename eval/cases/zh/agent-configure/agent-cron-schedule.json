{
  "id": "agent-cron-schedule",
  "lang": "zh",
  "category": "agent",
  "workflow": "agent-configure",
  "scenario_type": "single_turn",
  "description": "Create a cron-scheduled agent with an explicit timezone (covers `neomind agent create --schedule-type cron`).",
  "setup": {
    "fixture": "seed-empty"
  },
  "turns": [
    {
      "user": "创建一个名为「晨报」的 agent,提示词「汇总夜间设备告警」,每天早上 8 点(北京时间)运行一次。"
    }
  ],
  "applies": [
    "tool_accuracy",
    "task_completion",
    "language_adherence"
  ],
  "expectations": {
    "per_turn": [
      "T1: 用 `neomind agent create` 创建,--schedule-type cron、--schedule-config \"0 8 * * *\"、--timezone Asia/Shanghai"
    ],
    "overall": "Agent exists with a cron schedule storing expression 0 8 * * * and timezone Asia/Shanghai"
  },
  "expect": {
    "tools": [
      "shell"
    ],
    "commands": [
      "neomind agent create"
    ],
    "substrings": {
      "neomind agent create": [
        "--schedule-type",
        "cron",
        "0 8 * * *",
        "--timezone",
        "Asia/Shanghai"
      ]
    }
  },
  "state_queries": [
    {
      "type": "agent_exists",
      "params": {
        "name": "晨报"
      },
      "expected": true
    },
    {
      "type": "agent_config",
      "params": {
        "name": "晨报",
        "field": "schedule_type"
      },
      "expected": "cron"
    },
    {
      "type": "agent_config",
      "params": {
        "name": "晨报",
        "field": "cron_expression"
      },
      "expected": "0 8 * * *"
    },
    {
      "type": "agent_config",
      "params": {
        "name": "晨报",
        "field": "timezone"
      },
      "expected": "Asia/Shanghai"
    }
  ]
}
