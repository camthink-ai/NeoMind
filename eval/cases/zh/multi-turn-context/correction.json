{
  "id": "multi-turn-correction",
  "lang": "zh", "category": "rule", "workflow": "multi-turn-context", "scenario_type": "multi_turn",
  "description": "多轮纠正:第一轮建规则(sensor-001 电量<20告警,名叫 ctx-correct-rule),第二轮说'不对,我要 sensor-002 不是 sensor-001'。agent 必须删除/修正。",
  "setup": {"fixture": "seed-default"},
  "turns": [
    {"user": "建条规则,名字叫 ctx-correct-rule:当 sensor-001 电量低于 20 告警。"},
    {"user": "不对,我要监控的是 sensor-002,不是 sensor-001。改一下。"}
  ],
  "applies": ["tool_accuracy","task_completion","language_adherence"],
  "expectations": {"per_turn": ["T1: rule create(ctx-correct-rule on sensor-001)", "T2: rule update/delete+recreate(switch to sensor-002)"], "overall": "最终规则指向 sensor-002"},
  "expect": {"tools": ["shell"], "commands": ["neomind rule create", "neomind rule update"]},
  "state_queries": [{"type": "rule_exists", "params": {"name": "ctx-correct-rule"}, "expected": true}]
}
