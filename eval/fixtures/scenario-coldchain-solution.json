{
  "name": "scenario-coldchain-solution",
  "description": "Solution-level cold-chain compliance deployment (grocery, HACCP). NOT a single-point check — a whole-store system: 6 fridges across 3 categories (dairy/beverage threshold <4°C, frozen <-18°C) + door sensors + compressor state + storefront ambient, each in a realistic different state (temp drift / door-ajar / compressor-failed / normal). Tests whether the agent can DEPLOY a complete monitoring+response solution (per-device category-threshold rules + cross-cutting door/compressor rules + unified alert routing) end-to-end — a system-design probe AND a model-capability benchmark.",
  "device_types": [
    {
      "device_type": "display_fridge",
      "name": "Display Fridge",
      "categories": ["retail"],
      "metrics": [
        {"name": "temp_c", "display_name": "Temperature", "data_type": "Float", "unit": "°C"},
        {"name": "door_open_secs", "display_name": "Door Open", "data_type": "Integer", "unit": "s"},
        {"name": "compressor_running", "display_name": "Compressor", "data_type": "Boolean", "unit": ""}
      ],
      "commands": [
        {"name": "set_target_temp", "display_name": "Set Target Temp", "description": "Set fridge target temperature"},
        {"name": "trigger_defrost", "display_name": "Trigger Defrost", "description": "Trigger a defrost cycle"},
        {"name": "set_alarm", "display_name": "Set Alarm", "description": "Raise the fridge alarm"}
      ]
    },
    {
      "device_type": "ambient_sensor",
      "name": "Ambient Sensor",
      "categories": ["retail"],
      "metrics": [
        {"name": "temp_c", "display_name": "Temperature", "data_type": "Float", "unit": "°C"},
        {"name": "humidity_pct", "display_name": "Humidity", "data_type": "Float", "unit": "%"}
      ]
    }
  ],
