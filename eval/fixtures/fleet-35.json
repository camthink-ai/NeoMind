 "rules": [
  {
   "name": "warehouse-A-high-temp",
   "enabled": true,
   "condition": {
    "condition_type": "comparison",
    "source": "device:warehouse-A-sensor-04:temperature_c",
    "operator": "greater_than",
    "threshold": 25.0
   },
   "actions": [
    {
     "type": "notify",
     "message": "warehouse-A-sensor-04 hot: {value}C",
     "severity": "warning"
    }
   ],
   "cooldown": 60000
