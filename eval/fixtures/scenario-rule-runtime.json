{
  "name": "scenario-rule-runtime",
  "description": "Runtime rule-firing fixture: webhook-adapter device + a PRE-SEEDED rule (battery_level<20→notify). The rule is pre-seeded so the runtime inject can test the FIRING chain (webhook ingestion → DeviceMetric event → rule evaluate → notify → message) independent of the agent's rule-creation ability.",
  "device_types": [
    {
      "device_type": "webhook_sensor",
      "name": "Webhook Sensor",
      "categories": ["general"],
      "metrics": [
        {"name": "battery_level", "display_name": "Battery Level", "data_type": "Float", "unit": "%"}
      ]
    }
  ],
  "devices": [
    {"device_id": "webhook-sensor", "name": "Webhook Test Sensor", "device_type": "webhook_sensor", "adapter_type": "webhook", "connection_config": {}}
  ],
  "rules": [
    {
      "name": "low-battery-alert",
      "enabled": true,
      "trigger": {"trigger_type": "data_change"},
      "condition": {
        "condition_type": "comparison",
        "source": "device:webhook-sensor:battery_level",
        "operator": "less_than",
        "threshold": 20.0
      },
      "actions": [
        {"type": "notify", "message": "battery low: {value}%", "severity": "warning"}
      ],
      "cooldown": 60000
    }
  ]
}
