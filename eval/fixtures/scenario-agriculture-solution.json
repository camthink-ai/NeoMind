{
  "name": "scenario-agriculture-solution",
  "description": "Solution-level smart irrigation: a whole FARM (4 zones — tomato-field, corn-field, greenhouse, orchard — each with a soil-moisture probe + irrigation valve) + a weather station. tomato-field is dry (moisture 10, tomato needs >40), corn-field borderline (18, corn needs >30), greenhouse & orchard fine; weather shows a dry spell (rainfall 0). Tests deploying a complete irrigation PROGRAM (per-zone crop-threshold moisture rules + weather-aware + auto-open valves on dry zones + farmer-alert routing + assessment), not one valve.",
  "device_types": [
    {
      "device_type": "soil_moisture_probe",
      "name": "Soil Moisture Probe",
      "categories": ["agriculture"],
      "metrics": [
        {"name": "soil_moisture_pct", "display_name": "Soil Moisture", "data_type": "Float", "unit": "%"},
        {"name": "soil_temp_c", "display_name": "Soil Temperature", "data_type": "Float", "unit": "°C"}
      ]
    },
    {
      "device_type": "irrigation_valve",
      "name": "Irrigation Valve",
      "categories": ["agriculture"],
      "metrics": [
        {"name": "valve_open", "display_name": "Valve Open", "data_type": "Boolean", "unit": ""},
        {"name": "flow_rate_lpm", "display_name": "Flow Rate", "data_type": "Float", "unit": "L/min"}
      ],
      "commands": [
        {"name": "set_valve", "display_name": "Set Valve", "description": "open/close the valve (on/off)"}
      ]
    },
    {
      "device_type": "weather_station",
      "name": "Weather Station",
      "categories": ["agriculture"],
      "metrics": [
        {"name": "rainfall_mm", "display_name": "Rainfall", "data_type": "Float", "unit": "mm"},
        {"name": "air_temp_c", "display_name": "Air Temperature", "data_type": "Float", "unit": "°C"}
      ]
    }
  ],
