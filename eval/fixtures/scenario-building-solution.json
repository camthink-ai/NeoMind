{
  "name": "scenario-building-solution",
  "description": "Solution-level BMS: a whole FLOOR (3 zones: open-office + meeting-room-A + server-room), each with an environment sensor (CO2/occupancy/temp) + HVAC + lighting. meeting-room-A is high-CO2+occupied (needs ventilation); server-room is high-temp (unoccupied, equipment risk); open-office normal. Tests deploying a complete BMS automation suite (per-zone demand-controlled ventilation + occupancy-driven lighting + server-room temp protection + unified facilities-alert routing + assessment), not one room.",
  "device_types": [
    {
      "device_type": "room_environment_sensor",
      "name": "Room Environment Sensor",
      "categories": ["building"],
      "metrics": [
        {"name": "co2_ppm", "display_name": "CO2", "data_type": "Float", "unit": "ppm"},
        {"name": "occupancy", "display_name": "Occupancy", "data_type": "Integer", "unit": "people"},
        {"name": "temp_c", "display_name": "Temperature", "data_type": "Float", "unit": "°C"}
      ]
    },
    {
      "device_type": "hvac_unit",
      "name": "HVAC Unit",
      "categories": ["building"],
      "metrics": [
        {"name": "fan_speed_pct", "display_name": "Fan Speed", "data_type": "Float", "unit": "%"},
        {"name": "mode", "display_name": "Mode", "data_type": "String", "unit": ""}
      ],
      "commands": [
        {"name": "set_mode", "display_name": "Set Mode", "description": "cool/heat/ventilate/auto"},
        {"name": "set_setpoint", "display_name": "Set Setpoint", "description": "target temperature"},
        {"name": "set_fan_speed", "display_name": "Set Fan Speed", "description": "fan speed 0-100%"}
      ]
    },
    {
      "device_type": "lighting_controller",
      "name": "Lighting Controller",
      "categories": ["building"],
      "metrics": [
        {"name": "level_pct", "display_name": "Light Level", "data_type": "Float", "unit": "%"}
      ],
      "commands": [
        {"name": "set_level", "display_name": "Set Level", "description": "light level 0-100%"}
      ]
    }
  ],
