  "commands": [
    {
      "name": "ping",
      "display_name": "Ping / Heartbeat",
      "description": "Ask device to publish telemetry immediately and ack with pong. Alias on device: heartbeat.",
      "payload_template": "{\"cmd\": \"ping\"}",
      "parameters": [],
      "samples": [
        {
          "cmd": "ping"
        }
      ]
    },
    {
      "name": "clear",
      "display_name": "Clear / Fill Color",
      "description": "Fill the whole panel with one Spectra ink and full-refresh.",
      "payload_template": "{\"cmd\": \"clear\", \"params\": {\"color\": ${color}}}",
      "parameters": [
        {
          "name": "color",
          "display_name": "Color",
          "data_type": {
            "enum": {
              "options": [
                "white",
                "black",
                "yellow",
                "red",
                "blue",
                "green"
              ]
            }
          },
          "required": false,
          "default_value": "white",
          "help_text": "Ink color for full-panel fill"
        }
      ],
      "samples": [
        {
          "cmd": "clear",
          "params": {
            "color": "white"
          }
        },
        {
          "cmd": "clear",
          "params": {
            "color": "black"
          }
        }
      ]
    },
    {
      "name": "render_text",
      "display_name": "Render Text",
      "description": "Centered multi-line UTF-8 text (newline-separated, max 10 lines). ASCII 8×16 + GB2312 16×16 CJK (emoji/rare chars degrade). scale 1–13, default 3.",
      "payload_template": "{\"cmd\": \"render_text\", \"params\": {\"text\": ${text}, \"color\": ${color}, \"bg\": ${bg}, \"scale\": ${scale}}}",
      "parameters": [
        {
          "name": "text",
          "display_name": "Text",
          "data_type": "String",
          "required": true,
          "help_text": "Lines separated by \\n (max 10)"
        },
        {
          "name": "color",
          "display_name": "Text Color",
          "data_type": {
            "enum": {
              "options": [
                "black",
                "white",
                "yellow",
                "red",
                "blue",
                "green"
              ]
            }
          },
          "required": false,
          "default_value": "black"
        },
        {
          "name": "bg",
          "display_name": "Background",
          "data_type": {
            "enum": {
              "options": [
                "white",
                "black",
                "yellow",
                "red",
                "blue",
                "green"
              ]
            }
          },
          "required": false,
          "default_value": "white"
        },
        {
          "name": "scale",
          "display_name": "Font Scale",
          "data_type": "Integer",
          "required": false,
          "default_value": 3,
          "min": 1,
          "max": 13
        }
      ],
      "samples": [
        {
          "cmd": "render_text",
          "params": {
            "text": "Hello\nEK410",
            "color": "black",
            "bg": "white",
            "scale": 4
          }
        }
      ]
    },
    {
      "name": "render_canvas",
      "display_name": "Render Canvas (text/rect/QR)",
      "description": "Draw-list on logical landscape 1600×1200. items: text{x,y,text,color,scale}, rect{x,y,w,h,color,thickness,fill}, qr{x,y,text,color,scale}. Max 48 items, max 2 QR, each text ≤191 UTF-8 bytes. MQTT payload must stay under ~8 KB.",
      "payload_template": "{\"cmd\": \"render_canvas\", \"params\": {\"bg\": ${bg}, \"items\": ${items}}}",
      "parameters": [
        {
          "name": "bg",
          "display_name": "Background",
          "data_type": {
            "enum": {
              "options": [
                "white",
                "black",
                "yellow",
                "red",
                "blue",
                "green"
              ]
            }
          },
          "required": false,
          "default_value": "white"
        },
        {
          "name": "items",
          "display_name": "Items[]",
          "data_type": "Array",
          "required": true,
          "help_text": "JSON array of draw items (text / rect / qr)"
        }
      ],
      "samples": [
        {
          "cmd": "render_canvas",
          "params": {
            "bg": "white",
            "items": [
              {
                "type": "text",
                "x": 80,
                "y": 80,
                "text": "CamThink EK410",
                "scale": 4,
                "color": "black"
              },
              {
                "type": "qr",
                "x": 1200,
                "y": 400,
                "text": "https://wiki.camthink.ai",
                "scale": 6
              }
            ]
          }
        }
      ]
    },
    {
      "name": "display_url",
      "display_name": "Display Image / Frame from URL",
      "description": "Device HTTP-GETs the URL and full-refreshes. Preferred for quality: raw native 4bpp exactly 960000 bytes (platform/SoftAP pre-dither). Also accepts JPEG/PNG (on-device decode+dither, quality below SoftAP; max ~768 KB). WebP not supported — convert on host. URL must be reachable from the device LAN/WAN (not localhost). On failure the panel shows reason + SoftAP/raw guidance.",
      "payload_template": "{\"cmd\": \"display_url\", \"params\": {\"url\": ${url}}}",
      "parameters": [
        {
          "name": "url",
          "display_name": "Image / Frame URL",
          "data_type": "String",
          "required": true,
          "help_text": "http(s)://… .jpg|.png (≤~300KB recommended) or raw .bin (exactly 960000 B 4bpp). Prefer SoftAP Image upload or platform raw for best quality."
        }
      ],
      "samples": [
        {
          "cmd": "display_url",
          "params": {
            "url": "http://192.168.1.10/frames/ek410.bin"
          }
        },
        {
          "cmd": "display_url",
          "params": {
            "url": "https://example.com/photo.jpg"
          }
        }
      ]
    },
    {
      "name": "set_power",
      "display_name": "Set Power Mode",
      "description": "always = stay online; cycle = wake ~2 min then deep-sleep sleepMin minutes (optional wakeUrl on wake); hibernate = sleep immediately until MAIN button.",
      "payload_template": "{\"cmd\": \"set_power\", \"params\": {\"mode\": ${mode}, \"sleepMin\": ${sleepMin}, \"wakeUrl\": ${wakeUrl}}}",
      "parameters": [
        {
          "name": "mode",
          "display_name": "Mode",
          "data_type": {
            "enum": {
              "options": [
                "always",
                "cycle",
                "hibernate"
              ]
            }
          },
          "required": true,
          "default_value": "always"
        },
        {
          "name": "sleepMin",
          "display_name": "Sleep Minutes",
          "data_type": "Integer",
          "required": false,
          "default_value": 30,
          "min": 0,
          "visible_when": "mode == 'cycle'",
          "help_text": "Deep-sleep duration between wake windows (cycle mode)"
        },
        {
          "name": "wakeUrl",
          "display_name": "Wake Frame URL",
          "data_type": "String",
          "required": false,
          "default_value": "",
          "visible_when": "mode == 'cycle'",
          "help_text": "Optional display_url target fetched after wake (cycle mode)"
        }
      ],
      "samples": [
        {
          "cmd": "set_power",
          "params": {
            "mode": "always"
          }
        },
        {
          "cmd": "set_power",
          "params": {
            "mode": "cycle",
            "sleepMin": 30,
            "wakeUrl": ""
          }
        },
        {
          "cmd": "set_power",
          "params": {
            "mode": "hibernate"
          }
        }
      ]
    },
    {
      "name": "sleep_now",
      "display_name": "Sleep Now",
      "description": "Enter deep sleep immediately (screen retained). Wake with short-press MAIN. Alias on device: sleep.",
      "payload_template": "{\"cmd\": \"sleep_now\"}",
      "parameters": [],
      "samples": [
        {
          "cmd": "sleep_now"
        }
      ]
    },
    {
      "name": "reboot",
      "display_name": "Reboot",
      "description": "Reboot the device",
      "payload_template": "{\"cmd\": \"reboot\"}",
      "parameters": [],
      "samples": [
        {
          "cmd": "reboot"
        }
      ]
    }
  ],
  "default_offline_timeout_secs": 180,
  "ct_prov": {
    "model_code": null,
    "model_name": "EK410",
    "ap_ssid_families": [
      "EK410"
    ],
    "softap_default_host": "192.168.4.1",
    "supported_discovery": [
      "ap",
      "softap"
    ]
  }
}
