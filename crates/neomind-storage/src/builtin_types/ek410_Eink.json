{
  "device_type": "ek410_Eink",
  "name": "CamThink EK410 E-Ink Display",
  "description": "CamThink EK410 — 7.09\" six-color Spectra e-ink (logical landscape 1600×1200), ESP32-C61. MQTT topics: device/ek410_Eink/{deviceId}/uplink|downlink. Uplink is flat JSON; metric names = top-level keys. type=telemetry|status|cmd_ack share the same uplink — cmd_ack fields (last_cmd/cmd_status/detail) are listed as metrics so NeoMind can store them. Downlink: {cmd, params}. Best image: SoftAP Image upload or platform raw 4bpp 960000 B. Telemetry every 30 s; offline timeout 180 s.",
  "categories": [
    "MQTT",
    "Display",
    "E-Ink"
  ],
  "mode": "full",
  "store_raw": false,
  "metrics": [
